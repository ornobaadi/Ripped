<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-first app: same launch look regardless of system theme,
         so there is never a white flash on cold start. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/ripped_bg</item>
        <item name="android:navigationBarColor">@color/ripped_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ripped_bg</item>
    </style>
</resources>
